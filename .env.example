# Backend Port Configuration
PORT=5001

# SMTP Server Configurations (Default: Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# SMTP Auth Credentials
# For Gmail, EMAIL_USER is your full Gmail address (e.g., example@gmail.com)
EMAIL_USER=your_email_here@gmail.com

# For Gmail, EMAIL_PASS MUST be a 16-character App Password, NOT your regular password.
# To generate a Gmail App Password:
# 1. Go to your Google Account Settings (https://myaccount.google.com)
# 2. Go to Security -> 2-Step Verification (must be enabled first)
# 3. Scroll to the bottom and click on "App passwords"
# 4. Enter a name (e.g., "Portfolio Contact Form") and click "Create"
# 5. Copy the 16-character code (spaced out as xxxx xxxx xxxx xxxx) and paste it here without spaces.
EMAIL_PASS=your_gmail_app_password_here

# Destination Email
# This is the email address where portfolio contact inquiries will be sent.
EMAIL_TO=mitesh13500@gmail.com
